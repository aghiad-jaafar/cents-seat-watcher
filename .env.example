# Copy this file to .env and fill in your values.
# .env is gitignored - it must never be committed.

# From @BotFather on Telegram (/newbot, then copy the token)
TELEGRAM_BOT_TOKEN=

# From `npm run telegram:chatid`, after messaging your bot once
TELEGRAM_CHAT_ID=

# Optional email channel. Leave blank to keep it disabled.
# For Gmail, SMTP_PASS must be a 16-character App Password (needs 2FA enabled).
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL_TO=
